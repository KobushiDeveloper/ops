# ============================================================
#  BattleHood ops: konfiguracja (.env)  —  wersja Robinhood Chain
#  Skopiuj jako .env:   cp .env.example .env
#  Uzywaja jej OBA boty: operator-bot.mjs i monitor-bot.mjs
# ============================================================

# ---- Siec: Robinhood Chain ----
# RPC: Twoj endpoint Alchemy dla Robinhood Chain (albo publiczny RPC
# z oficjalnej dokumentacji). Chain ID Robinhood Chain: 4663.
RPC_URL=https://TWOJ-ENDPOINT-ALCHEMY-ROBINHOOD
CHAIN_ID=4663

# ---- Rynki (trzy listy W TEJ SAMEJ KOLEJNOSCI, po przecinku) ----
# CONTRACTS = adresy BattleHoodPrediction
# ORACLES   = adresy BattleHoodOracle (para do kazdej predykcji)
# SYMBOLS   = symbole gieldowe do pobierania cen
CONTRACTS=0x...,0x...,0x...,0x...
ORACLES=0x...,0x...,0x...,0x...
SYMBOLS=BTC,ETH,SOL,XRP

# ---- Bot operatora ----
# Klucz prywatny SWIEZEGO portfela operatora (tylko gaz, 0.05-0.1 ETH).
# Ten sam adres podajesz jako _updater przy deployu oracle
# i jako _operatorAddress przy deployu predykcji.
OPERATOR_KEY=0x...

# ---- Monitor (straznik) ----
# Publiczny ADRES portfela operatora (nie klucz!).
OPERATOR_ADDRESS=0x...

# Telegram: token bota z @BotFather + id czatu na alerty.
TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_CHAT_ID=123456789

# Progi (mozna zostawic)
GAS_ALERT=0.02
HEARTBEAT_HOURS=24
CHECK_SECONDS=30
